local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Player then
			pcall(function()
				local char = p.Character
				if not char then return end
				
				local head = char:FindFirstChild("Head")
				local hum = char:FindFirstChild("Humanoid")
				
				if head and hum and hum.Health > 0 then
					local role = getPlayerRole(p)
					local shouldShow = (role == "Murderer" and ESP_Murderer) or (role == "Sheriff" and ESP_Sheriff) or (role == "Innocent" and ESP_Innocent)
					
					local hl = char:FindFirstChild("ESP_Highlight")
					local bb = head:FindFirstChild("ESP_Billboard")

					if shouldShow then
						if not hl then
							hl = Instance.new("Highlight")
							hl.Name = "ESP_Highlight"
							hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							hl.Parent = char
						end
						hl.FillTransparency = 0.4
						hl.OutlineTransparency = 0

						if not bb then
							bb = Instance.new("BillboardGui")
							bb.Name = "ESP_Billboard"
							bb.Size = UDim2.fromOffset(120, 30)
							bb.StudsOffset = Vector3.new(0, 3, 0)
							bb.AlwaysOnTop = true
							bb.Parent = head

							local lbl = Instance.new("TextLabel")
							lbl.Name = "RoleLabel"
							lbl.Size = UDim2.fromScale(1, 1)
							lbl.BackgroundTransparency = 1
							lbl.Font = Enum.Font.GothamBold
							lbl.TextSize = 13
							lbl.TextStrokeTransparency = 0
							lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
							lbl.Parent = bb
						end

						local roleLabel = bb:FindFirstChild("RoleLabel")

						if role == "Murderer" then
							hl.FillColor = Color3.fromRGB(255, 40, 40)
							hl.OutlineColor = Color3.fromRGB(255, 250, 250)
							if roleLabel then
								roleLabel.Text = "🔴 ASESINO"
								roleLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
							end
						elseif role == "Sheriff" then
							hl.FillColor = Color3.fromRGB(40, 140, 255)
							hl.OutlineColor = Color3.fromRGB(255, 250, 250)
							if roleLabel then
								roleLabel.Text = "🔵 SHERIFF"
								roleLabel.TextColor3 = Color3.fromRGB(60, 160, 255)
							end
						else
							hl.FillColor = Color3.fromRGB(40, 255, 100)
							hl.OutlineColor = Color3.fromRGB(255, 250, 250)
							if roleLabel then
								roleLabel.Text = "🟢 INOCENTE"
								roleLabel.TextColor3 = Color3.fromRGB(70, 255, 120)
							end
						end
					else
						if hl then hl:Destroy() end
						if bb then bb:Destroy() end
					end
				else
					local hl = char:FindFirstChild("ESP_Highlight")
					if hl then hl:Destroy() end
					if head then
						local bb = head:FindFirstChild("ESP_Billboard")
						if bb then bb:Destroy() end
					end
				end
			end)
		end
	end
end

