local COOLDOWN = 24 * 60 * 60
local COOLDOWN_FILE = "XenonHubCooldown.txt"

local function readCooldown()
	if not isfile or not readfile then return 0 end
	local ok, result = pcall(function()
		if isfile(COOLDOWN_FILE) then
			return tonumber(readfile(COOLDOWN_FILE)) or 0
		end
		return 0
	end)
	return ok and result or 0
end

local function saveCooldown(timestamp)
	if not writefile then return false end
	return pcall(function()
		writefile(COOLDOWN_FILE, tostring(timestamp))
	end)
end

local function remainingTime()
	return math.max(0, COOLDOWN - (os.time() - readCooldown()))
end

local function formatTime(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function tw(o, t, p)
	return TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p)
end

