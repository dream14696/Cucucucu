local function updateCooldownDisplay()
	local left = remainingTime()
	if left > 0 then
		SendBtn.Text = "ESPERA " .. formatTime(left)
		SendBtn.BackgroundColor3 = Color3.fromRGB(55, 65, 80)
		SendBtn.Active = false
		TextBox.TextEditable = false
		Status.Text = "El administrador dormilón revisará tu sugerencia. 💙"
		Status.TextColor3 = Color3.fromRGB(160, 190, 220)
	else
		SendBtn.Text = "ENVIAR  ✈"
		SendBtn.BackgroundColor3 = Color3.fromRGB(0, 110, 220)
		SendBtn.Active = true
		TextBox.TextEditable = true
		Status.Text = "Puedes enviar una nueva sugerencia."
		Status.TextColor3 = Color3.fromRGB(180, 200, 220)
	end
end

SendBtn.MouseButton1Click:Connect(function()
	if sending then return end
	local left = remainingTime()
	if left > 0 then
		updateCooldownDisplay()
		return
	end

	local msg = TextBox.Text:match("^%s*(.-)%s*$")
	if #msg < 3 then
		Status.Text = "Escribe al menos 3 caracteres."
		Status.TextColor3 = Color3.fromRGB(255, 190, 70)
		return
	end

	sending = true
	SendBtn.Active = false
	SendBtn.Text = "ENVIANDO..."

	local success, err = sendFeedback(msg)
	if not success then
		sending = false
		Status.Text = err or "No se pudo enviar la sugerencia."
		Status.TextColor3 = Color3.fromRGB(255, 100, 100)
		updateCooldownDisplay()
		return
	end

	local saved = saveCooldown(os.time())
	BoxContainer.Visible = false
	SendBtn.Visible = false
	Status.Visible = false

	SuccessCheck.TextSize = 1
	SuccessCheck.TextTransparency = 0

	TweenService:Create(
		SuccessCheck,
		TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
