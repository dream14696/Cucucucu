local function vibrate()
	pcall(function()
		if HapticService:IsVibrationSupported(Enum.UserInputType.Gamepad1) then
			HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, .18)
			task.delay(.045, function() pcall(function() HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0) end) end)
		end
	end)
	pcall(function() if haptic then haptic(.18, .045) end end)
	pcall(function() if vibrateDevice then vibrateDevice(.045) end end)
end

